rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateOpt(val) {
      return val is string && val.size() <= 10 && val.matches('^(|\\d{4}-\\d{2}-\\d{2})$');
    }

    function isValidTimeOpt(val) {
      return val is string && val.size() <= 5 && val.matches('^(|\\d{2}:\\d{2})$');
    }

    // --- Tasks ---
    function isValidTask(data) {
      return data.keys().hasAll([
          'title', 'description', 'category',
          'dueDate', 'dueTime', 'priority', 'status', 'completedAt',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'category',
          'dueDate', 'dueTime', 'priority', 'status', 'completedAt',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.description is string && data.description.size() <= 1200
        && data.category in ['Academic', 'Personal', 'Projects', 'Coding Practice', 'College Activities', 'Other']
        && isValidDateOpt(data.dueDate)
        && isValidTimeOpt(data.dueTime)
        && data.priority in ['Low', 'Medium', 'High']
        && data.status in ['Pending', 'In Progress', 'Completed']
        && data.completedAt is string && data.completedAt.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /tasks/{taskId} {
      allow get: if isValidId(taskId);
      allow list: if true;
      allow create: if isValidId(taskId)
        && isValidTask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(taskId)
        && isValidTask(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'updatedAt'])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'category',
            'dueDate', 'dueTime', 'priority', 'status', 'completedAt', 'updatedAt'
          ])
        );
      allow delete: if isValidId(taskId);
    }
  }
}
