{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A student task with title, description, category, due date, priority, and status.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "minLength": 0, "maxLength": 1200 },
        "category": { "type": "string", "enum": ["Academic", "Personal", "Projects", "Coding Practice", "College Activities", "Other"] },
        "dueDate": { "type": "string", "minLength": 0, "maxLength": 10, "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$" },
        "dueTime": { "type": "string", "minLength": 0, "maxLength": 5, "pattern": "^(|\\d{2}:\\d{2})$" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Completed"] },
        "completedAt": { "type": "string", "minLength": 0, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "category", "dueDate", "dueTime", "priority", "status", "completedAt", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Student tasks stored at application scope without login requirements."
    }
  }
}
